# =========================================================
# GOOGLE ADS API CREDENTIALS
# Obtain from: Google Ads API Center (manager account) + GCP OAuth client
# https://ads.google.com/aw/apicenter
# =========================================================
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) customer ID, digits only, no dashes. Required once you manage >1 client account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# =========================================================
# DATABASE
# =========================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/google_ads_growth_mcp?schema=public"

# =========================================================
# SAFETY / APPROVAL BEHAVIOR
# =========================================================
# hard = server refuses to execute risky mutations without a human calling approve_change first (recommended for prod)
# soft = server logs a warning but still executes (use only in a sandbox/test account)
APPROVAL_MODE=hard

# Max % single budget change allowed without approval (e.g. 15 = +/-15%)
AUTO_APPROVE_BUDGET_CHANGE_PCT_MAX=15

# Absolute daily budget ceiling per campaign, in the account's currency's micros unit safeguard (informational, enforced in risk-engine.ts)
DEFAULT_MAX_DAILY_BUDGET=500

# =========================================================
# APP
# =========================================================
LOG_LEVEL=info
NODE_ENV=development
